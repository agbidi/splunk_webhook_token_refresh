{
  "oauth": {
    "token_url": "https://identity.example.com/oauth2/token",
    "client_id": "replace-with-client-id",
    "client_secret_env": "OAUTH_CLIENT_SECRET",
    "grant_type": "client_credentials",
    "scope": "replace-with-required-scope",
    "client_auth_method": "client_secret_post",
    "extra_token_params": {
      "audience": "replace-with-audience-if-required"
    }
  },
  "splunk": {
    "realm": "eu0",
    "integration_id": "replace-with-webhook-integration-id",
    "api_token_env": "SPLUNK_INTEGRATIONS_API_TOKEN"
  },
  "monitoring": {
    "enabled": true,
    "ingest_token_env": "SPLUNK_METRIC_INGEST_TOKEN",
    "metric_name": "splunk.webhook.oauth_token_refresh.success",
    "dimensions": {
      "environment": "production",
      "job": "webhook-token-refresh"
    }
  }
}
